# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI stays disabled until Gateway credentials and route tests are complete
AAHANA_AI_ENABLED=false
AAHANA_MODEL=openai/gpt-4.1-nano
AI_GATEWAY_API_KEY=

# Optional live web research (Tavily)
TAVILY_API_KEY=

# Optional private multilingual text-to-speech (Maya 2 Native)
# Keep the endpoint private/behind an authenticated reverse proxy; never expose it publicly.
AAHANA_MAYA_TTS_ENABLED=false
MAYA_TTS_URL=
MAYA_TTS_API_TOKEN=
MAYA_TTS_VOICE=Ahana
