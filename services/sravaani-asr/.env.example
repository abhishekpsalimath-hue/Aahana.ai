# Accept the gated model terms on Hugging Face and use a read-only token.
HF_TOKEN=

# REQUIRED: immutable 40–64 character Hugging Face commit SHA, never "main".
HF_MODEL_REVISION=

# Explicit acknowledgement after reviewing the exact pinned custom model code.
ALLOW_AUDITED_REMOTE_CODE=false

# Generate a random secret with at least 32 characters. Never commit the real value.
SRAVAANI_API_TOKEN=

# Configure these only on the Aahana Next.js server after the private service
# has passed its model, security and language-by-language verification gates.
AAHANA_SRAVAANI_ENABLED=false
SRAVAANI_ASR_URL=
SRAVAANI_SUPPORTED_LOCALES=
